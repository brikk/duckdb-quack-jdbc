index 4743418..1cc0a5a 100644
--- a/src/quack_http_server.cpp
+++ b/src/quack_http_server.cpp
@@ -1,3 +1,4 @@
+#include "duckdb/common/enums/statement_type.hpp"
 #include "duckdb/common/serializer/memory_stream.hpp"
 
 #include "quack_server.hpp"
@@ -81,9 +82,18 @@ HttpQuackServer::HttpQuackServer(ClientContext &context_p, const QuackUri &uri_p
 		res.status = 204;
 	});
 
-	server->Post("/quack", [&](const duckdb_httplib::Request &, duckdb_httplib::Response &res,
+	server->Post("/quack", [&](const duckdb_httplib::Request &req, duckdb_httplib::Response &res,
 	                           const duckdb_httplib::ContentReader &content_reader) {
 		res.set_header("Access-Control-Allow-Origin", "*");
+		// Private, versioned HTTP extension. No opt-in means unchanged v1 HTTP/binary behavior.
+		auto metadata_headers = req.get_header_value_count("X-Quack-Result-Metadata");
+		if (metadata_headers > 1 ||
+		    (metadata_headers == 1 && req.get_header_value("X-Quack-Result-Metadata") != "1")) {
+			res.status = 400;
+			res.set_header("Connection", "close");
+			res.set_content("Invalid X-Quack-Result-Metadata header\n", "text/plain");
+			return;
+		}
 		MemoryStream stream;
 		content_reader([&](const char *data, size_t data_length) {
 			stream.WriteData((data_ptr_t)data, data_length);
@@ -91,6 +101,33 @@ HttpQuackServer::HttpQuackServer(ClientContext &context_p, const QuackUri &uri_p
 		});
 		auto response = HandleMessage(stream);
 		response->ToMemoryStream(stream);
+		if (metadata_headers == 1 && response->Type() == MessageType::CONNECTION_RESPONSE) {
+			res.set_header("X-Quack-Result-Metadata", "1");
+			res.set_header("Access-Control-Expose-Headers", "X-Quack-Result-Metadata");
+		} else if (metadata_headers == 1 && response->Type() == MessageType::PREPARE_RESPONSE) {
+			auto return_type = response->Cast<PrepareResponseMessage>().ReturnType();
+			if (!return_type.IsValid()) {
+				throw InternalException("Missing Quack result return type metadata");
+			}
+			const char *result_kind;
+			// These strings are frozen for HTTP metadata version 1, independent of enum names/ordinals.
+			switch (return_type.GetIndex()) {
+			case static_cast<idx_t>(StatementReturnType::QUERY_RESULT):
+				result_kind = "query";
+				break;
+			case static_cast<idx_t>(StatementReturnType::CHANGED_ROWS):
+				result_kind = "changed_rows";
+				break;
+			case static_cast<idx_t>(StatementReturnType::NOTHING):
+				result_kind = "nothing";
+				break;
+			default:
+				throw InternalException("Unknown Quack result return type metadata: %llu", return_type.GetIndex());
+			}
+			res.set_header("X-Quack-Result-Metadata", "1");
+			res.set_header("X-Quack-Result-Kind", result_kind);
+			res.set_header("Access-Control-Expose-Headers", "X-Quack-Result-Metadata, X-Quack-Result-Kind");
+		}
 		res.set_content((const char *)stream.GetData(), stream.GetPosition(), "application/vnd.duckdb");
 	});
 
